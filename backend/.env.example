# Qwen/Ollama removed — migrated to Mistral Structured OCR (2026-07-07)

DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ai_accounting4
DB_PORT=3306
JWT_SECRET=your_jwt_secret_here
DJANGO_SECRET=your_django_secret_here
DJANGO_DEBUG=True
CLUSTER_ENV=local

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_email@example.com

# Infrastructure (Bulk Processing)
MAX_PAGES_PER_JOB=50
AI_MAX_RPS=5

# [MIGRATION] SQS & SHADOW MODE
QUEUE_BACKEND=sqs
MIGRATION_MODE=SHADOW
MIGRATION_TRAFFIC_PERCENTAGE=5

# [SCALABILITY]
AI_GLOBAL_CONCURRENCY=10
WORKER_CONCURRENCY=4

# [AWS SQS] - Dedicated Role Queues
SQS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-ingestion-queue
SQS_AI_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-ai-queue
SQS_ASSEMBLY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-assembly-queue
SQS_FINALIZE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-finalize-queue
SQS_EXPORT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-export-queue
SQS_MATERIALIZATION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-materialize-queue
SQS_DLQ_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-dlq
SQS_POISON_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/invoice-poison-queue
AWS_REGION=ap-south-1

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# [ORCHESTRATION] Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# [PHASE 10] CHAOS TESTING
CHAOS_MODE=False
CHAOS_CRASH_RATE=0.0
CHAOS_LATENCY_MS=0

ALLOWED_HOSTS=finpixe.com,www.finpixe.com,13.203.204.171,localhost,127.0.0.1

# [OCR] Rendering Configuration
OCR_DEFAULT_DPI=350

# [OCR] Mistral OCR Provider
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_MAX_RETRIES=3
MISTRAL_OCR_RETRY_DELAY_S=2.0
MISTRAL_OCR_ENCODE_QUALITY=95

# Validation Credentials
VALIDATION_USER=admin
VALIDATION_EMAIL=admin@budstech.com
VALIDATION_PASS=admin123

# Production Phase 3 Feature Flags
NORMALIZER_HSN_PROPAGATION=true
NORMALIZER_TAX_DISTRIBUTION=true
NORMALIZER_BUYER_RECOVERY=true
NORMALIZER_TAX_TOLERANCE=1.00

# Sandbox GST API
USE_MOCK_SANDBOX=True
SANDBOX_API_TEST_KEY=your_sandbox_api_test_key
SANDBOX_API_TEST_SECRET=your_sandbox_api_test_secret

WHITEBOOKS_CLIENT_ID=your_whitebooks_client_id
WHITEBOOKS_CLIENT_SECRET=your_whitebooks_client_secret
WHITEBOOKS_EMAIL=your_whitebooks_email
